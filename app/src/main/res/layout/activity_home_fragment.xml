<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Pemrograman Mobile"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPertemuan4"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#D32F2F"
        android:text="Pertemuan 4"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnPertemuan5"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#00838F"
        android:text="Pertemuan 5"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnPertemuan7"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#E65100"
        android:text="Pertemuan 7"
        android:textColor="@android:color/white" />

</LinearLayout>