<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Text Title / Welcome -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Welcome!"
            android:textColor="#3E3B47"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subjudul Silahkan pilih... -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Silahkan pilih..."
            android:textColor="#555555"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

        <!-- Baris 1: Pertemuan 4 (Kiri) & Pertemuan 5 (Kanan) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPertemuan4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="6dp"
            android:text="Pertemuan 4"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#1E88E5"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toStartOf="@+id/btnPertemuan5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPertemuan5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="24dp"
            android:text="Pertemuan 5"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#00897B"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnPertemuan4"
            app:layout_constraintTop_toTopOf="@id/btnPertemuan4" />

        <!-- Baris 2: Pertemuan 7 (Kiri) & Pertemuan 10 (Kanan) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPertemuan7"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:text="Pertemuan 7"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#FB8C00"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toStartOf="@+id/btnPertemuan10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPertemuan4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPertemuan10"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="24dp"
            android:text="Pertemuan 10"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#8E24AA"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnPertemuan7"
            app:layout_constraintTop_toTopOf="@id/btnPertemuan7" />

        <!-- Baris 3: Pertemuan 11 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPertemuan11"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Pertemuan 11"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#E53935"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="@id/btnPertemuan7"
            app:layout_constraintStart_toStartOf="@id/btnPertemuan7"
            app:layout_constraintTop_toBottomOf="@id/btnPertemuan7" />

        <!-- TextView Cat Fact -->
        <TextView
            android:id="@+id/tvCatFact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Loading cat fact..."
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPertemuan11" />

        <!-- Button Refresh -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="28dp"
            android:text="Refresh"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#5E4B9B"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCatFact" />

        <!-- RecyclerView Gallery Foto (Grid 2 Kolom) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRefresh"
            app:spanCount="2"
            tools:listitem="@layout/item_photo" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>